---
import type { Post } from "../lib/posts";
import { formatShortDate, getReadingTime } from "../lib/posts";

interface Props {
  posts: Post[];
  emptyMessage?: string;
}

const { posts, emptyMessage = "No writing has been published here yet." } = Astro.props;
---

{
  posts.length > 0 ? (
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-row" href={`/writing/${post.id}/`}>
            <time class="post-date" datetime={post.data.publishedAt.toISOString()}>
              {formatShortDate(post.data.publishedAt)}
            </time>
            <span class="post-title">{post.data.title}</span>
            <span class="post-meta">
              <span>{post.data.category}</span>
              <span>{getReadingTime(post.body ?? "")} min read</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty-state">{emptyMessage}</p>
  )
}
