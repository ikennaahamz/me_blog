---
const pathname = Astro.url.pathname;

const links = [
  { href: "/writing/", label: "Writing" },
  { href: "/books/", label: "Books" },
  { href: "/topics/", label: "Topics" },
  { href: "/about/", label: "About" },
];

function isCurrent(href: string): boolean {
  return href === "/writing/"
    ? pathname.startsWith("/writing/")
    : pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Ikenna Ahamz home">Ikenna Ahamz</a>
  <nav class="site-nav" aria-label="Primary navigation">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
    <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
      <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
      </svg>
      <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"></path>
      </svg>
    </button>
  </nav>
</header>
