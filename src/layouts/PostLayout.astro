---
import type { Post } from "../lib/posts";
import {
  formatDate,
  getPostExcerpt,
  getPostTopics,
  getPostTypeLabel,
  getReadingTime,
  getTopicLabel,
} from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
  relatedPost?: Post;
  newerPost?: Post;
  olderPost?: Post;
}

const { post, relatedPost, newerPost, olderPost } = Astro.props;
const topics = getPostTopics(post);
const readingTime = getReadingTime(post.body ?? "");
const description = getPostExcerpt(post) || post.data.description;
const deck = post.data.description.trim();
---

<BaseLayout
  title={post.data.title}
  description={description}
  type="article"
  publishedAt={post.data.publishedAt}
>
  <article class="article">
    <div class="page">
      <a class="back-link" href="/writing/">All writing</a>

      <header class="article-header layout-grid">
        <div class="article-margin">
          <time class="article-date" datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt)}
          </time>
          <span class="article-type">{getPostTypeLabel(post)}</span>
          <span class="article-reading-time">{readingTime} min read</span>
          <ul class="article-topics" aria-label="Article topics">
            {
              topics.map((topic) => (
                <li>
                  <a href={`/topics/${topic}/`}>{getTopicLabel(topic)}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="article-heading">
          <h1>{post.data.title}</h1>
          {deck && <p class="article-description">{deck}</p>}
        </div>
      </header>

      <div class="article-body layout-grid">
        <div class="article-margin" aria-hidden="true"></div>
        <div class="prose">
          <slot />
        </div>
      </div>

      <footer class="article-continuation layout-grid">
        <h2>Keep reading</h2>
        <div class="continuation-content">
          {
            relatedPost && (
              <article class="related-post">
                <p class="section-label">Related writing</p>
                <h3>
                  <a href={`/writing/${relatedPost.id}/`}>{relatedPost.data.title}</a>
                </h3>
                <p>{getPostExcerpt(relatedPost)}</p>
              </article>
            )
          }
          <nav class="article-pagination" aria-label="Continue reading">
            {
              newerPost && (
                <a class="article-pagination-link newer" href={`/writing/${newerPost.id}/`}>
                  <span>Newer</span>
                  <strong>{newerPost.data.title}</strong>
                </a>
              )
            }
            <a class="all-writing-link" href="/writing/">View all writing</a>
            {
              olderPost && (
                <a class="article-pagination-link older" href={`/writing/${olderPost.id}/`}>
                  <span>Older</span>
                  <strong>{olderPost.data.title}</strong>
                </a>
              )
            }
          </nav>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>
