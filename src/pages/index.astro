---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getPostTypeSummary,
  getPublishedPosts,
  getTopicCounts,
  getTopicLabel,
} from "../lib/posts";

const posts = await getPublishedPosts();
const topics = [...getTopicCounts(posts).entries()];
const latestPost = posts[0];

const books = (await getCollection("books", ({ data }) => !data.draft)).sort((left, right) =>
  left.data.authorSort.localeCompare(right.data.authorSort),
);
const notedBooks = books.filter((book) => (book.body ?? "").trim().length > 0);
---

<BaseLayout>
  <div class="page">
    <section class="home-hero layout-grid" aria-labelledby="home-title">
      <div class="home-margin">
        <span>Personal notes</span>
        <span>An occasional log</span>
      </div>
      <div>
        <h1 id="home-title" class="home-title">I've been <br />thinking...</h1>
        <p class="home-deck">
          I write essays and notes about philosophy, technology, and the books and conversations
          that change how I see things.
        </p>
        {
          latestPost && (
            <p class="home-latest">
              <span>Latest</span>
              <a href={`/writing/${latestPost.id}/`}>{latestPost.data.title}</a>
            </p>
          )
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="contents-title">
      <h2 class="section-label" id="contents-title">Contents</h2>
      <div class="section-body">
        <ol class="contents">
          <li>
            <a href="/writing/">
              <span class="contents-number">01</span>
              <span class="contents-name">Writing</span>
              <span class="contents-count">{getPostTypeSummary(posts)}</span>
            </a>
          </li>
          <li>
            <a href="/books/">
              <span class="contents-number">02</span>
              <span class="contents-name">The Forever Shelf</span>
              <span class="contents-count">{notedBooks.length} books</span>
            </a>
          </li>
          <li>
            <a href="/topics/">
              <span class="contents-number">03</span>
              <span class="contents-name">Topics</span>
              <span class="contents-count">{topics.length} subjects</span>
            </a>
          </li>
        </ol>
      </div>
    </section>

    <section class="home-section" aria-labelledby="topics-title">
      <h2 class="section-label" id="topics-title">Topics</h2>
      <div class="section-body">
        <ul class="topic-strip">
          {
            topics.map(([topic, count]) => (
              <li>
                <a href={`/topics/${topic}/`}>
                  {getTopicLabel(topic)}
                  <sup>{count}</sup>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
