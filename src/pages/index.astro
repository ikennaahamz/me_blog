---
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts, getTopicCounts } from "../lib/posts";

const posts = await getPublishedPosts();
const markedStartHerePosts = posts
  .filter((post) => post.data.startHereOrder !== undefined)
  .sort((left, right) => left.data.startHereOrder! - right.data.startHereOrder!);
const fallbackStartHerePosts = posts.filter(
  (post) => !markedStartHerePosts.some((markedPost) => markedPost.id === post.id),
);
const startHerePosts = [...markedStartHerePosts, ...fallbackStartHerePosts].slice(0, 2);
const recentPosts = posts
  .filter((post) => !startHerePosts.some((startHerePost) => startHerePost.id === post.id))
  .slice(0, 8);
const topics = [...getTopicCounts(posts).entries()];
const startHereLabels = ["Begin with the idea", "See how I work"];
---

<BaseLayout>
  <section class="home-intro" aria-labelledby="home-title">
    <p class="kicker">Personal notes</p>
    <h1 id="home-title">I've Been thinking.</h1>
    <p class="home-deck">
      I write about philosophy, books, technology, and the conversations that change how I see
      things.
    </p>
  </section>

  <section class="home-section start-here" aria-labelledby="start-here-title">
    <div class="section-label"><h2 id="start-here-title">Start here</h2></div>
    <ol class="start-here-grid">
      {
        startHerePosts.map((post, index) => (
          <li>
            <article class="start-here-card">
              <p class="start-here-label">{startHereLabels[index]}</p>
              <h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <a class="continue-link" href={`/writing/${post.id}/`}>
                Read this piece <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          </li>
        ))
      }
      <li>
        <article class="start-here-card">
          <p class="start-here-label">Browse the shelf</p>
          <h3><a href="/books/">The Forever Shelf</a></h3>
          <p>An unranked collection of books that continue to change how I think and see the world.</p>
          <a class="continue-link" href="/books/">
            Explore the shelf <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </li>
    </ol>
  </section>

  <section class="home-section" aria-labelledby="topics-title">
    <div class="section-label"><h2 id="topics-title">Topics</h2></div>
    <div>
      <ul class="topic-index">
        {topics.map(([topic, count]) => (
          <li><a href={`/topics/${topic}/`}><span>{topic}</span><sup>{count}</sup></a></li>
        ))}
      </ul>
      <a class="quiet-link" href="/topics/">Browse all topics <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="recent-title">
    <div class="section-label"><h2 id="recent-title">Recent writing</h2></div>
    <div>
      <PostList posts={recentPosts} />
      <a class="quiet-link" href="/writing/">View the complete archive <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</BaseLayout>
