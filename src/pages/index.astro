---
import { getCollection } from "astro:content";
import BookCover from "../components/BookCover.astro";
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatDate,
  getPostExcerpt,
  getPublishedPosts,
  getReadingTime,
  getTopicCounts,
  getTopicLabel,
} from "../lib/posts";

const posts = await getPublishedPosts();
const markedStartHerePosts = posts
  .filter((post) => post.data.startHereOrder !== undefined)
  .sort((left, right) => left.data.startHereOrder! - right.data.startHereOrder!);
const fallbackStartHerePosts = posts.filter(
  (post) => !markedStartHerePosts.some((markedPost) => markedPost.id === post.id),
);
const startHerePosts = [...markedStartHerePosts, ...fallbackStartHerePosts].slice(0, 2);
const [leadPost, nextStartPost] = startHerePosts;
const topics = [...getTopicCounts(posts).entries()];
const latestPost = posts[0];

const books = (await getCollection("books", ({ data }) => !data.draft)).sort((left, right) =>
  left.data.authorSort.localeCompare(right.data.authorSort),
);
const notedBooks = books.filter((book) => (book.body ?? "").trim().length > 0);
const shelfBooks = (notedBooks.length >= 3 ? notedBooks : books).slice(0, 3);
---

<BaseLayout>
  <div class="page">
    <section class="home-hero layout-grid" aria-labelledby="home-title">
      <div class="home-margin">
        <span>Personal notes</span>
        <span>An occasional log</span>
      </div>
      <div>
        <h1 id="home-title" class="home-title">I've been <br />thinking.</h1>
        <p class="home-deck">
          I write about philosophy, books, technology, and the conversations that change how I see
          things.
        </p>
        {
          latestPost && (
            <p class="home-latest">
              <span>Latest</span>
              <a href={`/writing/${latestPost.id}/`}>{latestPost.data.title}</a>
            </p>
          )
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="contents-title">
      <h2 class="section-label" id="contents-title">Contents</h2>
      <div class="section-body">
        <ol class="contents">
          <li>
            <a href="#start-here">
              <span class="contents-number">01</span>
              <span class="contents-name">Start here</span>
              <span class="contents-count">{startHerePosts.length} essays</span>
            </a>
          </li>
          <li>
            <a href="/books/">
              <span class="contents-number">02</span>
              <span class="contents-name">The Forever Shelf</span>
              <span class="contents-count">{books.length} books</span>
            </a>
          </li>
          <li>
            <a href="/topics/">
              <span class="contents-number">03</span>
              <span class="contents-name">Topics</span>
              <span class="contents-count">{topics.length} subjects</span>
            </a>
          </li>
          <li>
            <a href="/writing/">
              <span class="contents-number">04</span>
              <span class="contents-name">Writing</span>
              <span class="contents-count">{posts.length} entries</span>
            </a>
          </li>
        </ol>
      </div>
    </section>

    <section id="start-here" class="home-section" aria-labelledby="start-here-title">
      <h2 class="section-label" id="start-here-title">Start here</h2>
      <div class="section-body">
        {
          leadPost && (
            <div class="home-lead">
              <div class="lead-copy">
                <p class="lead-kicker">Begin with the idea</p>
                <h3 class="lead-title">
                  <a href={`/writing/${leadPost.id}/`}>{leadPost.data.title}</a>
                </h3>
                <p class="lead-description">{getPostExcerpt(leadPost)}</p>
                <ul class="lead-meta">
                  <li>
                    <time datetime={leadPost.data.publishedAt.toISOString()}>
                      {formatDate(leadPost.data.publishedAt)}
                    </time>
                  </li>
                  <li>{getReadingTime(leadPost.body ?? "")} min read</li>
                  <li>{leadPost.data.category}</li>
                </ul>
                {
                  nextStartPost && (
                    <a class="next-start" href={`/writing/${nextStartPost.id}/`}>
                      <span>Next</span>
                      {nextStartPost.data.title}
                    </a>
                  )
                }
              </div>
              {
                shelfBooks.length > 0 && (
                  <figure class="shelf-mini">
                    <a
                      class="shelf-stack"
                      href="/books/"
                      aria-label="Browse The Forever Shelf"
                    >
                      {shelfBooks.map((book) => (
                        <BookCover book={book} width={240} />
                      ))}
                    </a>
                    <figcaption class="shelf-caption">
                      <span>The Forever Shelf</span>
                      <span>{books.length} books</span>
                    </figcaption>
                  </figure>
                )
              }
            </div>
          )
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="recent-title">
      <h2 class="section-label" id="recent-title">Recent writing</h2>
      <div class="section-body">
        <PostList posts={posts} />
        <a class="more-link" href="/writing/">All writing</a>
      </div>
    </section>

    <section class="home-section" aria-labelledby="topics-title">
      <h2 class="section-label" id="topics-title">Topics</h2>
      <div class="section-body">
        <ul class="topic-strip">
          {
            topics.map(([topic, count]) => (
              <li>
                <a href={`/topics/${topic}/`}>
                  {getTopicLabel(topic)}
                  <sup>{count}</sup>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
