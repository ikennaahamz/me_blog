---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import BookCarousel, { type CarouselBookItem } from "../components/BookCarousel.astro";
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getBookSpinePalette,
  getPublishedBooks,
  getShortAuthor,
  getSpineTitle,
  hasNote,
} from "../lib/books";

const books = await getPublishedBooks();

const notedBooks = books.filter(hasNote);
const readingList = books.filter((book) => !hasNote(book));
const orderedBooks = [...notedBooks, ...readingList];

const prepared = await Promise.all(
  orderedBooks.map(async (book, index) => {
    const noted = hasNote(book);
    const cover = book.data.cover;
    let coverUrl: string | null = null;
    let aspect = 0.667;

    if (cover) {
      if (typeof cover === "string") {
        coverUrl = cover;
      } else {
        const optimized = await getImage({ src: cover, width: 640, format: "webp" });
        coverUrl = optimized.src;
        aspect = cover.width / cover.height;
      }
    }

    const palette = await getBookSpinePalette(book);
    const Content = noted ? (await render(book)).Content : undefined;

    const item: CarouselBookItem = {
      id: book.id,
      index: index + 1,
      title: book.data.title,
      spineTitle: getSpineTitle(book.data.title),
      author: book.data.author,
      shortAuthor: getShortAuthor(book.data),
      isbn: book.data.isbn,
      summary: book.data.summary,
      hasNote: noted,
      group: noted ? "noted" : "reading",
      coverUrl,
      aspect,
      palette,
      Content,
    };

    return { book, item };
  }),
);

const carouselItems = prepared.map(({ item }) => item);
const shelf = prepared
  .filter(({ item }) => item.hasNote && item.Content)
  .map(({ book, item }, index) => ({
    book,
    index,
    Content: item.Content!,
  }));
---

<BaseLayout
  title="The Forever Shelf"
  description="An unranked collection of the books Ikenna returns to, with notes and a reading list."
>
  <div class="page">
    <PageIntro
      label="Library"
      title="The Forever Shelf"
      deck={`An unranked collection of ${orderedBooks.length} books on my shelf. ${notedBooks.length} have notes; ${readingList.length} are on the reading list.`}
      note={`${notedBooks.length} books with notes`}
    >
      <a class="more-link" href="/books/reading-list/">
        Reading list · {readingList.length} books
      </a>
    </PageIntro>

    <BookCarousel items={carouselItems} />

    <ol class="book-catalogue" aria-label="Book notes">
      {
        shelf.map(({ book, index, Content }) => (
          <li class="book-card" id={`book-${book.id}`}>
            <p class="book-index">{String(index + 1).padStart(3, "0")}</p>
            <article class="book-entry">
              <h2>{book.data.title}</h2>
              <p class="book-author">{book.data.author}</p>
              {book.data.summary && <p class="book-summary">{book.data.summary}</p>}
              <details class="book-details">
                <summary>Read full note</summary>
                <div class="book-note">
                  <Content />
                </div>
              </details>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
