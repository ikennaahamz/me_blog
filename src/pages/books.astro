---
import { getCollection, render } from "astro:content";
import PageIntro from "../components/PageIntro.astro";
import ShelfWall from "../components/ShelfWall.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const books = await getCollection("books", ({ data }) => !data.draft);
books.sort(
  (left, right) =>
    left.data.authorSort.localeCompare(right.data.authorSort) ||
    left.data.title.localeCompare(right.data.title),
);

const notedBooks = books.filter((book) => (book.body ?? "").trim().length > 0);
const readingList = books.filter((book) => (book.body ?? "").trim().length === 0);

const shelf = await Promise.all(
  notedBooks.map(async (book, index) => ({
    book,
    index,
    Content: (await render(book)).Content,
  })),
);
---

<BaseLayout
  title="The Forever Shelf"
  description="An unranked collection of the books Ikenna returns to, with notes and a reading list."
>
  <div class="page">
    <PageIntro
      label="Library"
      title="The Forever Shelf"
      deck={`An unranked collection of books I return to. ${notedBooks.length} have notes; the rest are on the reading list.`}
      note={`${notedBooks.length} books with notes`}
    >
      <a class="more-link" href="/books/reading-list/">
        Reading list · {readingList.length} books
      </a>
    </PageIntro>

    {
      notedBooks.length > 0 && (
        <ShelfWall books={notedBooks} columns={Math.min(notedBooks.length, 5)} />
      )
    }

    <ol class="book-catalogue" aria-label="Book notes">
      {
        shelf.map(({ book, index, Content }) => (
          <li class="book-card" id={`book-${book.id}`}>
            <p class="book-index">{String(index + 1).padStart(3, "0")}</p>
            <article class="book-entry">
              <h2>{book.data.title}</h2>
              <p class="book-author">{book.data.author}</p>
              {book.data.summary && <p class="book-summary">{book.data.summary}</p>}
              <details class="book-details">
                <summary>Read full note</summary>
                <div class="book-note">
                  <Content />
                </div>
              </details>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
