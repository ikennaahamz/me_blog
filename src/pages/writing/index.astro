---
import PageIntro from "../../components/PageIntro.astro";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPostTypeSummary, getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
const typeSummary = getPostTypeSummary(posts);
const years = Map.groupBy(posts, (post) => post.data.publishedAt.getUTCFullYear());
---

<BaseLayout title="Writing" description="Essays and notes by Ikenna Ahamz.">
  <div class="page">
    <PageIntro
      label="Archive"
      title="Writing"
      deck="Essays and working notes collected over time."
      note={typeSummary}
    >
      <p class="archive-note">
        Book notes live in <a href="/books/">The Forever Shelf</a>.
      </p>
    </PageIntro>

    <div class="year-groups">
      {
        [...years.entries()].map(([year, yearPosts]) => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="year-label">
              {year}
            </h2>
            <PostList posts={yearPosts} />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
