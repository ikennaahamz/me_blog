---
import PageIntro from "../../components/PageIntro.astro";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPostTopics, getPublishedPosts, getTopicCounts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return [...getTopicCounts(posts).keys()].map((topic) => ({ params: { topic }, props: { topic } }));
}

const { topic } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => getPostTopics(post).includes(topic));
---

<BaseLayout title={topic} description={`Writing by Ikenna Ahamz about ${topic}.`}>
  <div class="page">
    <PageIntro
      label="Topic"
      title={topic}
      note={`${posts.length} ${posts.length === 1 ? "entry" : "entries"}`}
    />
    <PostList posts={posts} />
  </div>
</BaseLayout>
