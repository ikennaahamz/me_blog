---
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getTopicCounts, getTopicLabel } from "../../lib/posts";

const posts = await getPublishedPosts();
const topics = [...getTopicCounts(posts).entries()];
---

<BaseLayout title="Topics" description="Browse Ikenna Ahamz's writing by topic.">
  <div class="page">
    <PageIntro
      label="Index"
      title="Topics"
      deck="Recurring subjects across the essays and notes."
      note={`${topics.length} ${topics.length === 1 ? "subject" : "subjects"}`}
    />

    <div class="layout-grid">
      <ul class="topic-directory body-column">
        {
          topics.map(([topic, count]) => (
            <li>
              <a href={`/topics/${topic}/`}>
                <span class="topic-name">{getTopicLabel(topic)}</span>
                <span class="topic-count">
                  {count} {count === 1 ? "entry" : "entries"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
