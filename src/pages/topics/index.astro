---
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getTopicCounts } from "../../lib/posts";

const posts = await getPublishedPosts();
const topics = [...getTopicCounts(posts).entries()];
---

<BaseLayout title="Topics" description="Browse Ikenna Ahamz's writing by topic.">
  <div class="page">
    <PageIntro
      label="Index"
      title="Topics"
      deck="Recurring questions and subjects across the archive."
      note={`${topics.length} ${topics.length === 1 ? "subject" : "subjects"}`}
    />

    <ul class="topic-directory">
      {
        topics.map(([topic, count]) => (
          <li>
            <a href={`/topics/${topic}/`}>
              <span class="topic-name">{topic}</span>
              <span class="topic-count">
                {count} {count === 1 ? "entry" : "entries"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
