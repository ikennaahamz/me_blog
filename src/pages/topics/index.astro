---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getTopicCounts } from "../../lib/posts";

const posts = await getPublishedPosts();
const topics = [...getTopicCounts(posts).entries()];
---

<BaseLayout title="Topics" description="Browse Ikenna Ahamz's writing by topic.">
  <header class="page-header">
    <p class="kicker">Index</p>
    <h1>Topics</h1>
    <p>Recurring questions and subjects across the archive.</p>
  </header>

  <ul class="topic-directory">
    {
      topics.map(([topic, count]) => (
        <li>
          <a href={`/topics/${topic}/`}>
            <span>{topic}</span>
            <span>{count} {count === 1 ? "entry" : "entries"}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
